+def test_persistent_root_accepts_default_workspace(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    persistent_root = tmp_path / "data"
+    paths = PathLayout(persistent_root / ".octop")
+    monkeypatch.setenv("OCTOP_PERSISTENT_ROOT", str(persistent_root))
+
+    cfg: dict = {}
+    host = seed_workspace_dir_on_create(cfg, paths=paths, agent_id="PERSIST1")
+
+    assert host == (persistent_root / ".octop" / "agents" / "PERSIST1").resolve()
+    assert host.is_dir()
+
+
+@pytest.mark.parametrize("ensure", [False, True])
+def test_persistent_root_rejects_default_home_before_mkdir(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, ensure: bool
+) -> None:
+    persistent_root = tmp_path / "data"
+    outside_home = tmp_path / "ephemeral-home"
+    monkeypatch.setenv("OCTOP_PERSISTENT_ROOT", str(persistent_root))
+    paths = PathLayout(outside_home)
+    with pytest.raises(ValueError, match="must be under persistent root"):
+        default_agent_workspace_dir(paths, "OUTSIDE", ensure=ensure)
+    assert not outside_home.exists()
+
+
