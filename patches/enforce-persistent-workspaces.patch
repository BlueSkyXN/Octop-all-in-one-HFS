+def test_persistent_root_accepts_default_workspace(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    persistent_root = tmp_path / "data"
+    paths = PathLayout(persistent_root / ".octop")
+    monkeypatch.setenv("OCTOP_PERSISTENT_ROOT", str(persistent_root))
+
+    cfg: dict = {}
+    host = seed_workspace_dir_on_create(cfg, paths=paths, agent_id="PERSIST1")
+
+    assert host == (persistent_root / ".octop" / "agents" / "PERSIST1").resolve()
+    assert host.is_dir()
+
+
+def test_persistent_root_rejects_workspace_outside_volume(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    persistent_root = tmp_path / "data"
+    paths = PathLayout(persistent_root / ".octop")
+    outside_root = tmp_path / "ephemeral"
+    monkeypatch.setenv("OCTOP_PERSISTENT_ROOT", str(persistent_root))
+
+    custom_cfg = {"workspace_dir": str(outside_root / "custom")}
+    with pytest.raises(ValueError, match="must be under persistent root"):
